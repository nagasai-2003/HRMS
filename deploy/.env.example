# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# Your web address, without https:// (for example hr.mycompany.com or
# myhr.duckdns.org). Caddy gets the HTTPS certificate for it by itself.
# For a quick test behind a Cloudflare tunnel, use :80 instead.
SITE_ADDRESS=hr.example.com

# Database password. Make one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Encrypts everyone's authenticator app secret. Make one with:
#   openssl rand -hex 32
# Save a copy in a password manager. Never change or lose it: without it,
# every person has to set up their authenticator again.
MFA_KEY=

# The name shown in people's authenticator app (for example your company name).
MFA_ISSUER=HR Workspace

# Password for the first admin (setup-admin) or for every demo account (seed).
# 12 characters or more. You can delete this line after setup.
SEED_PASSWORD=

# Leave empty unless the web pages are served from a different address than
# SITE_ADDRESS. Example for a Cloudflare quick tunnel: *.trycloudflare.com
ALLOWED_ORIGINS=

# Ports on this machine. Keep 80 and 443 on a server.
HTTP_PORT=80
HTTPS_PORT=443
